// rewrite react-toastify component style
.Toastify__toast-container {
  z-index: 9999;
  -webkit-transform: translate3d(0, 0, 9999px);
  position: fixed;
  padding: 0px;
  max-width: 720px;
  width: auto;
//   top: 5em;
  top: 108px;
  left: calc(50% - 142px);
  transform: translateX(-50%);
  box-sizing: border-box;
  color: #fff;
  height: 40px;
}


.Toastify__toast {
   width: auto;
   text-align: center;
   min-height: 0px;
   color: #545659;
   font-weight normal
   box-shadow: 0px 6px 16px 0px rgba(0, 0, 0, 0.08), 0px 3px 6px -4px rgba(0, 0, 0, 0.12);
   border-radius: 25px;
   border: 1px solid #d5d6d9;
   height: 40px;
}
.Toastify__toast-body{
    width: 100%;
    padding: 0px 30px 0px 8px;
}

.Toastify__close-button {
    width: 0px;
    display: none;
}

// Health notices contain diagnostics and actions, unlike the one-line status toasts.
.Toastify__toast-container.mcp-health-notifications {
    top: 16px;
    left: 50%;
    width: calc(100vw - 32px);
    max-width: 560px;
    height: auto;
    max-height: calc(100vh - 32px);
    overflow-y: auto;
    transform: translateX(-50%);
}

.mcp-health-notifications {
    .Toastify__toast {
        height: auto;
        max-height: none;
        border-radius: 8px;
        text-align: left;
        padding: 16px;
    }
    .Toastify__toast-body {
        min-width: 0;
        padding: 0;
    }
    .Toastify__toast-body > div:last-child {
        min-width: 0;
        width: 100%;
    }
    .Toastify__close-button {
        display: block;
        width: 24px;
        height: 24px;
        flex-shrink: 0;
        margin-left: 8px;
    }
    .mcp-health-notice {
        overflow-wrap: anywhere;
    }
    .mcp-health-notice-message {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        min-height: 48px;
        max-height: calc(100vh - 220px);
        overflow-y: auto;
        margin: 8px 0 12px;
    }
    .mcp-health-notice-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
}

